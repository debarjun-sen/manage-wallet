# Copy to .env.local and fill in. Leave the Supabase values empty to build the original local-only app.

# --- Public (bundled into the app; safe to expose) ---
# Supabase Dashboard -> Project Settings -> API (or "Connect"): Project URL and anon / publishable key
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# From `npm run vapid` (public key). Leave empty to disable push notifications.
VITE_VAPID_PUBLIC_KEY=

# --- Server only (Vercel Functions; never prefix with VITE_) ---
# Supabase: service_role / secret key. Used only by api/notify.ts.
SUPABASE_SERVICE_ROLE_KEY=
# From `npm run vapid` (private key)
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:admin@example.com
