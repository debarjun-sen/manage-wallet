{
  "name": "manage-wallet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/write-headers.mjs && tsc --noEmit && tsc --noEmit -p api/tsconfig.json && vite build",
    "headers": "node scripts/write-headers.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
